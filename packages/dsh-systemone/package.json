{
  "name": "@local/systemone",
  "version": "0.2.3",
  "private": true,
  "type": "module",
  "description": "System One tools, decision layer, and Settings page for DeepSeek Harness: typed asks, image assets, five hook-driven decisions, swarm mode, and live endpoint/credential configuration.",
  "engines": {
    "node": ">=24",
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "lib/**/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "test/**/*.mjs",
    "vendor/**/*",
    "README.md"
  ],
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-api-remotes"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node test/run.mjs"
  }
}
